@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuevo Equipo Tecnológico</title>
    <style>
        :root {
            --primary-color: #007bff;
            --success-color: #28a745;
            --secondary-color: #6c757d;
            --light-bg: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-bg);
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        /* --- ANIMACIÓN DE ENTRADA (Zoom) --- */
        @@keyframes zoomExplosion {
            0% {
                opacity: 0;
                transform: scale(0.5);
            }

            60% {
                transform: scale(1.05);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* --- ANIMACIÓN DE SALIDA (TV Retro) --- */
        @@keyframes tvOff {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.05);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.05);
                opacity: 0;
            }
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            background-color: white;
            padding: 30px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            border-radius: 8px;
            animation: zoomExplosion 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .animacion-salida {
            animation: tvOff 0.9s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0;
            color: #333;
            font-size: 1.6rem;
        }

        .excel-panel {
            background-color: #e8f5e9;
            border: 1px dashed var(--success-color);
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 0.85rem;
            color: #444;
            text-transform: uppercase;
        }

        input, select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.95rem;
            background-color: #fff;
        }

            input[readonly] {
                background-color: #f0f0f0;
                cursor: not-allowed;
                color: #666;
            }

        .highlight {
            border: 1px solid var(--primary-color);
            background-color: #f0f7ff;
        }

        .actions {
            margin-top: 40px;
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            border-top: 1px solid #eee;
            padding-top: 25px;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .btn-save {
            background-color: var(--primary-color);
            color: white;
        }

        .btn-cancel {
            background-color: var(--secondary-color);
            color: white;
        }

        .btn-excel {
            background-color: var(--success-color);
            color: white;
        }

        @@media (max-width: 900px) {
            .form-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .header-flex {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-flex">
            <h1>Registro de Activo Tecnológico</h1>
            <button class="btn btn-cancel" onclick="volverAlIndex(event)">Volver</button>
        </div>

        <div class="excel-panel">
            <span>¿Carga masiva de equipos? Utilice la plantilla de Excel.</span>
            <button class="btn btn-excel">Importar Excel</button>
        </div>

        <form action="/Inventario/Guardar" method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label>Número de Serie</label>
                    <input type="text" id="Serie" name="Serie" class="highlight" placeholder="Ingrese Serie" required oninput="syncIdentificador()" />
                </div>
                <div class="form-group"><label>Identificador</label><input type="text" id="Identificador" readonly /></div>
                <div class="form-group"><label>Fecha</label><input type="text" id="FechaCreacion" readonly /></div>

                <div class="form-group"><label>Fabricante</label><input type="text" name="Fabricante" /></div>
                <div class="form-group"><label>Modelo</label><input type="text" name="Modelo" /></div>
                <div class="form-group"><label>Hostname</label><input type="text" name="Hostname" /></div>
                <div class="form-group"><label>Sucursal</label><input type="text" name="Sucursal" required /></div>
                <div class="form-group"><label>Estado</label><select name="Estado"><option>Operativo</option><option>Descartado</option></select></div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn-cancel" onclick="volverAlIndex(event)">Cancelar</button>
                <button type="submit" class="btn btn-save">Guardar Activo</button>
            </div>
        </form>
    </div>

    <script>
        function volverAlIndex(e) {
            if (e) e.preventDefault();

            var contenedor = document.querySelector('.container');
            contenedor.classList.add('animacion-salida');

            setTimeout(function () {
                location.href = '/Inventario/Index';
            }, 400);
        }

        function syncIdentificador() {
            const serie = document.getElementById('Serie').value;
            document.getElementById('Identificador').value = serie;
        }

        window.onload = function () {
            const ahora = new Date();
            document.getElementById('FechaCreacion').value = ahora.toLocaleDateString() + ' ' + ahora.toLocaleTimeString();
        };
    </script>
</body>
</html>