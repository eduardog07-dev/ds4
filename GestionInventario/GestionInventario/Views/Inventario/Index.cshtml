@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Inventario</title>
    <style>
        :root {
            --color_primario: #007bff;
            --color_secundario: #6c757d;
            --color_exito: #28a745;
            --color_advertencia: #ffc107;
            --color_info: #17a2b8;
            --color_peligro: #dc3545;
            --fondo_oscuro: #343a40;
            --fondo_claro: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--fondo_claro);
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            overflow-x: hidden;
        }

        /* CORRECCIÓN: @@ PARA EVITAR ERROR DE COMPILACIÓN */
        @@keyframes tv_apagada {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.08);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.08);
                opacity: 0;
            }
        }

        @@keyframes entrada {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .contenedor_principal {
            width: 90%;
            max-width: 1200px;
            margin: 40px auto;
            background-color: white;
            padding: 40px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 12px;
            text-align: center;
        }

        .animacion_salida {
            animation: tv_apagada 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2.5rem;
        }

        h3 {
            color: #666;
            margin-bottom: 40px;
            font-weight: normal;
        }

        /* --- DASHBOARD DE STOCK --- */
        .dashboard_stock {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
            margin-bottom: 50px;
            padding: 20px;
        }

        .tarjeta_stock {
            padding: 25px;
            border-radius: 12px;
            color: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease; /* Suavizado */
            cursor: default; /* Ya no es un enlace */
            min-height: 140px;
            animation: entrada 0.6s ease-out forwards;
            opacity: 0; /* Para la animación */
        }

            .tarjeta_stock:hover {
                transform: translateY(-10px); /* Se levanta más notablemente */
                box-shadow: 0 15px 30px rgba(0,0,0,0.2); /* Sombra más profunda al levantar */
            }

        .ts_titulo {
            font-size: 1.1rem;
            font-weight: bold;
            opacity: 0.9;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .ts_cantidad {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 10px;
        }

        .ts_estado {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.9;
            background: rgba(0,0,0,0.2);
            padding: 4px 12px;
            border-radius: 20px;
        }

        /* Colores */
        .bg_rojo {
            background: linear-gradient(135deg, #ff6b6b, #ee5253);
        }

        .bg_naranja {
            background: linear-gradient(135deg, #feca57, #ff9f43);
            color: #333 !important;
        }

            .bg_naranja .ts_estado {
                color: #333;
                background: rgba(255,255,255,0.3);
            }

        .bg_verde {
            background: linear-gradient(135deg, #1dd1a1, #10ac84);
        }

        .bg_azul {
            background: linear-gradient(135deg, #54a0ff, #2e86de);
        }

        .barra_herramientas {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 40px;
        }

        .boton {
            padding: 15px 40px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            color: white;
            text-decoration: none;
            font-size: 1.1rem;
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
        }

            .boton:hover {
                transform: translateY(-4px);
                box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            }

        .boton_primario {
            background-color: var(--color_primario);
        }

        .boton_info {
            background-color: var(--color_info);
        }

        /* Media Queries con @@ */
        @@media (max-width: 768px) {
            .barra_herramientas {
                flex-direction: column;
                width: 100%;
                gap: 15px;
            }

            .boton {
                width: 100%;
                text-align: center;
            }

            .dashboard_stock {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="contenedor_principal">
        <h1>Panel de Control</h1>
        <h3>Resumen de Inventario (Equipos Disponibles)</h3>

        <div id="panel_stock" class="dashboard_stock">
            <div style="grid-column: 1/-1; text-align:center; padding: 40px; color:#777;">
                Cargando indicadores...
            </div>
        </div>

        <div class="barra_herramientas">
            <button class="boton boton_primario" onclick="navegar(event, '/Inventario/NuevoProducto')">
                + Nuevo Producto
            </button>

            <button class="boton boton_info" onclick="navegar(event, '/Inventario/Consultas')">
                Ver Listado Completo &#8594;
            </button>
        </div>
    </div>

    <script>
        function navegar(e, urlDestino) {
            if (e) e.preventDefault();
            var contenedor = document.querySelector('.contenedor_principal');
            contenedor.classList.add('animacion_salida');
            setTimeout(function () { location.href = urlDestino; }, 600);
        }

        window.onload = function () {
            cargar_resumen();
        };

        async function cargar_resumen() {
            try {
                const respuesta = await fetch('/api/productos/resumen');
                const panel = document.getElementById('panel_stock');

                if (respuesta.ok) {
                    const datos = await respuesta.json();

                    if (datos.length === 0) {
                        panel.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding:30px;">No hay datos registrados.</div>';
                        return;
                    }

                    let html = '';
                    datos.forEach((d, index) => {
                        let claseColor = 'bg_verde';
                        if (d.Color === 'rojo') claseColor = 'bg_rojo';
                        if (d.Color === 'naranja') claseColor = 'bg_naranja';
                        if (d.Color === 'azul') claseColor = 'bg_azul';

                        // Agregamos un delay de animación para efecto cascada
                        const styleAnim = `animation-delay: ${index * 0.1}s`;

                        // Sin evento onclick, solo visualización
                        html += `
                                <div class="tarjeta_stock ${claseColor}" style="${styleAnim}">
                                    <div class="ts_titulo">${d.Tipo}</div>
                                    <div class="ts_cantidad">${d.Cantidad}</div>
                                    <div class="ts_estado">${d.Estado}</div>
                                </div>
                            `;
                    });
                    panel.innerHTML = html;
                } else {
                    panel.innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:red;">Error al cargar datos del servidor.</div>';
                }
            } catch (error) {
                console.error("Error resumen:", error);
                document.getElementById('panel_stock').innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:red;">Error de conexión.</div>';
            }
        }
    </script>
</body>
</html>