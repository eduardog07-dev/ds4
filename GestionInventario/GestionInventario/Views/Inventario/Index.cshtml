@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Control de Inventario - Hardware</title>
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --info-color: #17a2b8;
            --dark-bg: #343a40;
            --light-bg: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-bg);
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            overflow-x: hidden;
        }

        /* --- ANIMACIÓN DE SALIDA (TV Retro) --- */
        @@keyframes tvOff {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.05);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.05);
                opacity: 0;
            }
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 20px auto;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        /* Clase para la animación JS */
        .animacion-salida {
            animation: tvOff 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }

        /* --- TOOLBAR CENTRADA --- */
        .toolbar {
            display: flex;
            justify-content: center; /* CENTRADO HORIZONTAL */
            align-items: center;
            flex-wrap: wrap;
            gap: 20px; /* Separación entre botones */
            margin-bottom: 20px;
            padding: 15px;
            background-color: #e9ecef;
            border-radius: 8px;
        }

        .btn {
            padding: 12px 25px; /* Botones un poco más grandes */
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            text-decoration: none;
            font-size: 15px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
                opacity: 0.95;
            }

        .btn-NProducto {
            background-color: var(--primary-color);
        }

        .btn-Consultas {
            background-color: var(--info-color);
        }

        /* --- TABLA --- */
        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: var(--dark-bg);
            color: white;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        .stock-bajo {
            color: #dc3545;
            font-weight: bold;
            background-color: #ffeaea;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .estado-ok {
            color: var(--success-color);
            font-weight: bold;
        }

        /* --- MÓVIL --- */
        @@media (max-width: 768px) {
            .toolbar {
                flex-direction: column;
                width: 100%;
                box-sizing: border-box;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            thead {
                display: none;
            }

            table, tbody, tr, td {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            tr {
                margin-bottom: 20px;
                border: 1px solid #ddd;
                border-radius: 10px;
                box-shadow: 0 4px 8px rgba(0,0,0,0.05);
                background-color: white;
            }

            td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 15px;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

                td:last-child {
                    border-bottom: none;
                }
                /* Quitamos borde al último elemento */

                td::before {
                    content: attr(data-label);
                    font-weight: bold;
                    color: #555;
                    text-align: left;
                    margin-right: 20px;
                    text-transform: uppercase;
                    font-size: 0.8rem;
                }
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Gestión de Inventario</h1>

        <div class="toolbar">
            <button class="btn btn-NProducto" onclick="navegar(event, '/Inventario/NuevoProducto')">
                + Nuevo Producto
            </button>

            <button class="btn btn-Consultas" onclick="navegar(event, '/Inventario/Consultas')">
                Ir a Consultas y Reportes ➔
            </button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock Actual</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-label="Código">HW-001</td>
                        <td data-label="Producto">Monitor 24" LED</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual">15</td>
                        <td data-label="Precio">$120.00</td>
                        <td data-label="Estado"><span class="estado-ok">Disponible</span></td>
                    </tr>
                    <tr>
                        <td data-label="Código">HW-002</td>
                        <td data-label="Producto">Teclado Mecánico</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual"><span class="stock-bajo">2</span></td>
                        <td data-label="Precio">$45.00</td>
                        <td data-label="Estado"><span style="color:orange; font-weight:bold;">Stock Bajo</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function navegar(e, urlDestino) {
            if (e) e.preventDefault();

            var contenedor = document.querySelector('.container');
            contenedor.classList.add('animacion-salida');

            setTimeout(function () {
                location.href = urlDestino;
            }, 400);
        }
    </script>

</body>
</html>
