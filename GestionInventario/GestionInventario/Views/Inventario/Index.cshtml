@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Control de Inventario - Hardware</title>
    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --info-color: #17a2b8;
            --dark-bg: #343a40;
            --light-bg: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light-bg);
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 20px auto;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }

        /* --- TOOLBAR --- */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #e9ecef;
            border-radius: 8px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            text-decoration: none;
            font-size: 14px;
            text-align: center;
            transition: transform 0.3s;
        }

            .btn:hover {
                transform: translateY(-4px);
                opacity: 0.9;
            }

        .btn_NProducto {
            background-color: var(--primary-color);
        }

        .btn-RMovimiento {
            background-color: var(--warning-color);
            color: #212529;
        }

        .btn-info {
            background-color: var(--info-color);
        }

        /* --- TABLA ESTÁNDAR (PC) --- */
        .table-container {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: var(--dark-bg);
            color: white;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        .stock-bajo {
            color: #dc3545;
            font-weight: bold;
            background-color: #ffeaea;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .estado-ok {
            color: var(--success-color);
            font-weight: bold;
        }

        .acciones-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: bold;
            margin: 0 5px;
        }

        /* --- MODO MÓVIL (TARJETAS) --- */
        @@media (max-width: 768px) {
            /* Ajuste Toolbar */
            .toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-group {
                display: grid;
                grid-template-columns: 1fr;
                gap: 10px;
            }
            /* Ocultar cabeceras de tabla */
            thead {
                display: none;
            }

            table, tbody, tr, td {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }
            /* Estilo de la "Tarjeta" (cada fila es una tarjeta) */
            tr {
                margin-bottom: 20px;
                border: 1px solid #ddd;
                border-radius: 10px;
                box-shadow: 0 4px 8px rgba(0,0,0,0.05);
                background-color: white;
                overflow: hidden; /* Para que los bordes redondeados funcionen bien */
            }
            /* Estilo de cada celda (Fila dentro de la tarjeta) */
            td {
                display: flex; /* Usamos Flexbox para alinear Label - Valor */
                justify-content: space-between; /* Separa los extremos */
                align-items: center;
                padding: 12px 15px;
                border-bottom: 1px solid #eee;
                text-align: right; /* El valor se alinea a la derecha */
            }
                /* La etiqueta (Label) generada por CSS */
                td::before {
                    content: attr(data-label);
                    font-weight: bold;
                    color: #555;
                    text-align: left;
                    margin-right: 20px; /* Espacio entre label y valor */
                    text-transform: uppercase;
                    font-size: 0.8rem;
                    flex-shrink: 0; /* Evita que la etiqueta se aplaste */
                }
                /* CORRECCIÓN: Botones de Acción */
                td:last-child {
                    border-bottom: none;
                    background-color: #f8f9fa; /* Fondo gris suave para diferenciar */
                    justify-content: center; /* Centrar los botones */
                    padding: 15px;
                }
                    /* En la celda de acciones, no queremos la etiqueta "Acciones" a la izquierda */
                    td:last-child::before {
                        display: none;
                    }
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Gestión de Inventario</h1>

        <div class="toolbar">
            <div class="btn-group">
                <button class="btn btn_NProducto" onclick="location.href='/Inventario/NuevoProducto'"> + Nuevo Producto </button>
                <button class="btn btn-RMovimiento" onclick="alert('Formulario Movimientos')">Registrar Movimiento</button>
            </div>
            <div class="btn-group">
                <button class="btn btn-info" onclick="location.href='/Inventario/Consultas'">Ir a Consultas y Reportes ➔</button>
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock Actual</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-label="Código">HW-001</td>
                        <td data-label="Producto">Monitor 24" LED</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual">15</td>
                        <td data-label="Precio">$120.00</td>
                        <td data-label="Estado"><span class="estado-ok">Disponible</span></td>
                        <td data-label="Acciones">
                            <a href="#" class="acciones-link">Editar</a> |
                            <a href="#" class="acciones-link" style="color:#dc3545;">Eliminar</a>
                        </td>
                    </tr>

                    <tr>
                        <td data-label="Código">HW-002</td>
                        <td data-label="Producto">Teclado Mecánico</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual"><span class="stock-bajo">2</span></td>
                        <td data-label="Precio">$45.00</td>
                        <td data-label="Estado"><span style="color:orange; font-weight:bold;">Stock Bajo</span></td>
                        <td data-label="Acciones">
                            <a href="#" class="acciones-link">Editar</a> |
                            <a href="#" class="acciones-link" style="color:#dc3545;">Eliminar</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>