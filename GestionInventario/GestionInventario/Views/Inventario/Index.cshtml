@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Control de Inventario - Hardware</title>
    <style>
        :root {
            --color_primario: #007bff;
            --color_secundario: #6c757d;
            --color_exito: #28a745;
            --color_advertencia: #ffc107;
            --color_info: #17a2b8;
            --fondo_oscuro: #343a40;
            --fondo_claro: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--fondo_claro);
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            overflow-x: hidden;
        }

        @@keyframes tv_apagada {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.04);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.04);
                opacity: 0;
            }
        }

        .contenedor_principal {
            width: 90%;
            max-width: 1200px;
            margin: 20px auto;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        .animacion_salida {
            animation: tv_apagada 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }

        .barra_herramientas {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
            padding: 15px;
            background-color: #e9ecef;
            border-radius: 8px;
        }

        .boton {
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            text-decoration: none;
            font-size: 15px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .boton:hover {
                transform: translateY(-4px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
                opacity: 0.95;
            }

        .boton_primario {
            background-color: var(--color_primario);
        }

        .boton_info {
            background-color: var(--color_info);
        }

        .contenedor_tabla {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: var(--fondo_oscuro);
            color: white;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        .stock_bajo {
            color: #dc3545;
            font-weight: bold;
            background-color: #ffeaea;
            padding: 4px 8px;
            border-radius: 4px;
        }

        .estado_ok {
            color: var(--color_exito);
            font-weight: bold;
        }

        @@media (max-width: 768px) {
            .barra_herramientas {
                flex-direction: column;
                width: 100%;
                box-sizing: border-box;
            }

            .boton {
                width: 100%;
                justify-content: center;
            }

            thead {
                display: none;
            }

            table, tbody, tr, td {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            tr {
                margin-bottom: 20px;
                border: 1px solid #ddd;
                border-radius: 10px;
                box-shadow: 0 4px 8px rgba(0,0,0,0.05);
                background-color: white;
            }

            td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 15px;
                border-bottom: 1px solid #eee;
                text-align: right;
            }

                td:last-child {
                    border-bottom: none;
                }

                td::before {
                    content: attr(data-label);
                    font-weight: bold;
                    color: #555;
                    text-align: left;
                    margin-right: 20px;
                    text-transform: uppercase;
                    font-size: 0.8rem;
                }
        }
    </style>
</head>
<body>

    <div class="contenedor_principal">
        <h1>Gestión de Inventario</h1>

        <div class="barra_herramientas">
            <button class="boton boton_primario" onclick="navegar(event, '/Inventario/NuevoProducto')">
                + Nuevo Producto
            </button>

            <button class="boton boton_info" onclick="navegar(event, '/Inventario/Consultas')">
                Ir a Consultas y Reportes ➔
            </button>
        </div>

        <div class="contenedor_tabla">
            <table>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock Actual</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-label="Código">HW-001</td>
                        <td data-label="Producto">Monitor 24" LED</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual">15</td>
                        <td data-label="Precio">$120.00</td>
                        <td data-label="Estado"><span class="estado_ok">Disponible</span></td>
                    </tr>
                    <tr>
                        <td data-label="Código">HW-002</td>
                        <td data-label="Producto">Teclado Mecánico</td>
                        <td data-label="Categoría">Periféricos</td>
                        <td data-label="Stock Actual"><span class="stock_bajo">2</span></td>
                        <td data-label="Precio">$45.00</td>
                        <td data-label="Estado"><span style="color:orange; font-weight:bold;">Stock Bajo</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function navegar(e, urlDestino) {
            if (e) e.preventDefault();

            var contenedor = document.querySelector('.contenedor_principal');
            contenedor.classList.add('animacion_salida');

            setTimeout(function () {
                location.href = urlDestino;
            }, 400);
        }
    </script>

</body>
</html>
