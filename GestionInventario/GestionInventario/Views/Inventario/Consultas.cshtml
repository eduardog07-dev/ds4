@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consultas y Reportes</title>
    <style>
        :root {
            --color_primario: #007bff;
            --color_exito: #28a745;
            --color_info: #17a2b8;
            --color_secundario: #6c757d;
            --fondo_oscuro: #343a40;
            --fondo_claro: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--fondo_claro);
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        /* --- ESTILOS DE PANTALLA DE CARGA --- */
        #overlay_carga {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            color: white;
            display: none;
            justify-content: center;
            align-items: center;
            font-size: 2rem;
            z-index: 9999;
            flex-direction: column;
        }

        .spinner {
            border: 8px solid #f3f3f3;
            border-top: 8px solid var(--color_primario);
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: girar 1s linear infinite;
            margin-bottom: 20px;
        }

        @@keyframes girar {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }
        /* ------------------------------------------- */

        @@keyframes zoom_explosion {
            0% {
                opacity: 0;
                transform: scale(0.5);
            }

            60% {
                transform: scale(1.05);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes tv_apagada {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.05);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.05);
                opacity: 0;
            }
        }

        .contenedor_principal {
            max-width: 1200px;
            margin: 0 auto;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            border-radius: 8px;
            animation: zoom_explosion 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .animacion_salida {
            animation: tv_apagada 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        .encabezado_flexible {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .panel_busqueda {
            background-color: #e9ecef;
            padding: 20px;
            border-radius: 8px;
            display: flex;
            gap: 15px;
            align-items: flex-end;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .grupo_formulario {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 14px;
            color: #555;
        }

        input[type="text"], select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            min-width: 200px;
        }

        .boton {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            font-size: 14px;
            transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
        }

            .boton:hover {
                transform: translateY(-2px);
                opacity: 0.95;
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            }

        .boton_volver {
            background-color: var(--color_secundario);
        }

        .boton_buscar {
            background-color: var(--color_primario);
        }

        .boton_excel {
            background-color: var(--color_info);
        }

        .area_resultados {
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: var(--fondo_oscuro);
            color: white;
        }

        .texto_tenue {
            color: #6c757d;
            font-size: 0.85rem;
            display: block;
        }

        .etiqueta {
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.8rem;
        }

        /* Estilos de etiquetas */
        .etiqueta_operativo {
            background-color: #d4edda;
            color: #155724;
        }

        .etiqueta_baja {
            background-color: #f8d7da;
            color: #721c24;
        }

        .etiqueta_prestamo {
            background-color: #fff3cd;
            color: #856404;
        }

        @@media (max-width: 768px) {
            .panel_busqueda {
                flex-direction: column;
                align-items: stretch;
            }

            .grupo_formulario input, .grupo_formulario select {
                width: 100%;
                box-sizing: border-box;
            }

            .boton {
                width: 100%;
                margin-top: 5px;
            }

            table, thead, tbody, th, td, tr {
                display: block;
            }

                thead tr {
                    position: absolute;
                    top: -9999px;
                    left: -9999px;
                }

            tr {
                border: 1px solid #ccc;
                margin-bottom: 10px;
                padding: 10px;
                border-radius: 5px;
            }

            td {
                border: none;
                position: relative;
                padding-left: 50%;
            }

                td:before {
                    position: absolute;
                    left: 10px;
                    content: attr(data-label);
                    font-weight: bold;
                }
        }
    </style>
</head>
<body>

    <div id="overlay_carga">
        <div class="spinner"></div>
        <span id="texto_carga">Procesando...</span>
    </div>

    <div class="contenedor_principal">
        <div class="encabezado_flexible">
            <h1>Consultas y Reportería</h1>
            <button class="boton boton_volver" onclick="volver_al_inicio(event)">← Volver al Inventario</button>
        </div>

        <div class="panel_busqueda">
            <div class="grupo_formulario">
                <label>Búsqueda General:</label>
                <input type="text" id="txtBuscar" placeholder="Serie, Hostname, IP o Usuario..." />
            </div>

            <div class="grupo_formulario">
                <label>Tipo Equipo:</label>
                <select id="selTipo">
                    <option value="">-- Todos --</option>
                    <option value="Laptop">Laptop</option>
                    <option value="Desktop">Desktop</option>
                    <option value="Servidor">Servidor</option>
                    <option value="Tablet">Tablet</option>
                </select>
            </div>

            <div class="grupo_formulario">
                <label>Estado:</label>
                <select id="selEstado">
                    <option value="">-- Todos --</option>
                    <option value="Operativo">Operativo</option>
                    <option value="Prestamo">Préstamo</option>
                    <option value="Descartado">Descartado</option>
                </select>
            </div>

            <div class="grupo_formulario">
                <label>&nbsp;</label>
                <button class="boton boton_buscar" onclick="buscar_productos()">🔍 Buscar</button>
            </div>

            <div style="flex-grow: 1;"></div>

            <div class="grupo_formulario">
                <label>Reportes:</label>
                <div style="display:flex;">
                    <button class="boton boton_excel" onclick="exportar_excel()">📊 Exportar Reporte</button>
                </div>
            </div>
        </div>

        <div class="area_resultados">
            <h3>Resultados de la búsqueda</h3>
            <table>
                <thead>
                    <tr>
                        <th>Serie (ID)</th>
                        <th>Equipo / Modelo</th>
                        <th>Red (IP/Host)</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="tablaResultados">
                    <tr><td colspan="5" style="text-align:center; padding: 20px; color: #777;">Utilice los filtros para buscar...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Función para mostrar/ocultar carga
        function mostrar_carga(mostrar, mensaje = "Procesando...") {
            const overlay = document.getElementById('overlay_carga');
            const texto = document.getElementById('texto_carga');
            texto.innerText = mensaje;
            overlay.style.display = mostrar ? 'flex' : 'none';
        }

        function volver_al_inicio(e) {
            if (e) e.preventDefault();
            var contenedor = document.querySelector('.contenedor_principal');
            contenedor.classList.add('animacion_salida');
            setTimeout(function () { location.href = '/Inventario/Index'; }, 400);
        }

        // --- 1. FUNCIÓN BUSCAR ---
        async function buscar_productos() {
            const txt = document.getElementById('txtBuscar').value;
            const tipo = document.getElementById('selTipo').value;
            const estado = document.getElementById('selEstado').value;

            mostrar_carga(true, "Buscando..."); // Activar Spinner

            const url = `/api/productos/buscar?texto=${txt}&tipo=${tipo}&estado=${estado}`;

            try {
                const respuesta = await fetch(url);
                mostrar_carga(false); // Desactivar Spinner

                if (respuesta.ok) {
                    const productos = await respuesta.json();
                    const cuerpo = document.getElementById('tablaResultados');

                    if (productos.length === 0) {
                        cuerpo.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px;">No se encontraron resultados.</td></tr>';
                        return;
                    }

                    let html = '';
                    productos.forEach(p => {
                        let claseEstado = 'etiqueta_operativo';
                        if (p.Estado === 'Descartado') claseEstado = 'etiqueta_baja';
                        // Normalizamos la lógica para detectar el préstamo con o sin tilde en la visualización
                        if (p.Estado === 'Préstamo' || p.Estado === 'Prestamo') claseEstado = 'etiqueta_prestamo';

                        // Validación de datos nulos
                        const serie = p.Serie || "---";
                        const id = p.Identificador || serie;
                        const modelo = p.Modelo || "---";
                        const tipoCI = p.TipoCI || "---";
                        const host = p.Hostname || "---";
                        const ip = p.IP || "---";
                        const suc = p.Sucursal || "---";
                        const est = p.Estado || "---";

                        html += `
                                <tr>
                                    <td data-label="Serie">${serie}<br><span class="texto_tenue">ID: ${id}</span></td>
                                    <td data-label="Equipo"><strong>${modelo}</strong><br><span class="texto_tenue">${tipoCI}</span></td>
                                    <td data-label="Red">${host}<br><span class="texto_tenue">${ip}</span></td>
                                    <td data-label="Ubicación">${suc}</td>
                                    <td data-label="Estado"><span class="etiqueta ${claseEstado}">${est}</span></td>
                                </tr>`;
                    });
                    cuerpo.innerHTML = html;
                } else {
                    alert("Error buscando: " + await respuesta.text());
                }
            } catch (error) {
                mostrar_carga(false);
                console.error("Error buscando:", error);
                alert("Error de conexión con el servidor.");
            }
        }

        // --- 2. FUNCIÓN EXPORTAR EXCEL ---
        function exportar_excel() {
            const txt = document.getElementById('txtBuscar').value;
            const tipo = document.getElementById('selTipo').value;
            const estado = document.getElementById('selEstado').value;

            mostrar_carga(true, "Generando Excel...");

            setTimeout(() => {
                const url = `/api/productos/exportar?texto=${txt}&tipo=${tipo}&estado=${estado}`;
                window.location.href = url;
                mostrar_carga(false);
            }, 1000);
        }
    </script>
</body>
</html>