@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consultas y Reportes</title>
    <style>
        :root {
            --color_primario: #007bff;
            --color_exito: #28a745;
            --color_info: #17a2b8;
            --color_secundario: #6c757d;
            --fondo_oscuro: #343a40;
            --fondo_claro: #f4f4f9;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--fondo_claro);
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        @@keyframes zoom_explosion {
            0% {
                opacity: 0;
                transform: scale(0.5);
            }

            60% {
                transform: scale(1.05);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes tv_apagada {
            0% {
                transform: scale(1, 1);
                opacity: 1;
            }

            40% {
                transform: scale(1, 0.07);
                opacity: 1;
            }

            100% {
                transform: scale(0, 0.07);
                opacity: 0;
            }
        }

        .contenedor_principal {
            max-width: 1200px;
            margin: 0 auto;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            border-radius: 8px;
            animation: zoom_explosion 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        .animacion_salida {
            animation: tv_apagada 0.9s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        .encabezado_flexible {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .panel_busqueda {
            background-color: #e9ecef;
            padding: 20px;
            border-radius: 8px;
            display: flex;
            gap: 15px;
            align-items: flex-end;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .grupo_formulario {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 14px;
            color: #555;
        }

        input[type="text"], select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            min-width: 200px;
        }

        .boton {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            font-size: 14px;
            transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
        }

            .boton:hover {
                transform: translateY(-4px);
                opacity: 0.95;
                box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            }

        .boton_volver {
            background-color: var(--color_secundario);
        }

        .boton_buscar {
            background-color: var(--color_primario);
        }

        .boton_excel {
            background-color: var(--color_info);
        }

        .area_resultados {
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background-color: var(--fondo_oscuro);
            color: white;
        }

        .texto_tenue {
            color: #6c757d;
            font-size: 0.85rem;
            display: block;
        }

        .etiqueta {
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 0.8rem;
        }

        .etiqueta_operativo {
            background-color: #d4edda;
            color: #155724;
        }

        @@media (max-width: 768px) {
            .panel_busqueda {
                flex-direction: column;
                align-items: stretch;
            }

            .grupo_formulario input, .grupo_formulario select {
                width: 100%;
                box-sizing: border-box;
            }

            .boton {
                width: 100%;
                margin-top: 5px;
            }

            table, thead, tbody, th, td, tr {
                display: block;
            }

                thead tr {
                    position: absolute;
                    top: -9999px;
                    left: -9999px;
                }

            tr {
                border: 1px solid #ccc;
                margin-bottom: 10px;
                padding: 10px;
                border-radius: 5px;
            }

            td {
                border: none;
                position: relative;
                padding-left: 50%;
            }

                td:before {
                    position: absolute;
                    left: 10px;
                    content: attr(data-label);
                    font-weight: bold;
                }
        }
    </style>
</head>
<body>

    <div class="contenedor_principal">
        <div class="encabezado_flexible">
            <h1>Consultas y Reportería</h1>
            <button class="boton boton_volver" onclick="volver_al_inicio(event)">← Volver al Inventario</button>
        </div>

        <div class="panel_busqueda">
            <div class="grupo_formulario">
                <label>Búsqueda General:</label>
                <input type="text" placeholder="Serie, Hostname, IP o Usuario..." />
            </div>

            <div class="grupo_formulario">
                <label>Tipo Equipo:</label>
                <select>
                    <option value="">-- Todos --</option>
                    <option value="Laptop">Laptop</option>
                    <option value="Desktop">Desktop</option>
                    <option value="Servidor">Servidor</option>
                    <option value="Tablet">Tablet</option>
                </select>
            </div>

            <div class="grupo_formulario">
                <label>Estado:</label>
                <select>
                    <option value="">-- Todos --</option>
                    <option value="Operativo">Operativo</option>
                    <option value="Prestamo">Préstamo</option>
                    <option value="Descartado">Descartado</option>
                </select>
            </div>

            <div class="grupo_formulario">
                <label>&nbsp;</label>
                <button class="boton boton_buscar">🔍 Buscar</button>
            </div>

            <div style="flex-grow: 1;"></div>

            <div class="grupo_formulario">
                <label>Reportes:</label>
                <div style="display:flex;">
                    <button class="boton boton_excel">📊 Exportar Reporte</button>
                </div>
            </div>
        </div>

        <div class="area_resultados">
            <h3>Resultados de la búsqueda</h3>
            <table>
                <thead>
                    <tr>
                        <th>Serie (ID)</th>
                        <th>Equipo / Modelo</th>
                        <th>Red (IP/Host)</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-label="Serie">CND8234X<br><span class="texto_tenue">ID: CND8234X</span></td>
                        <td data-label="Equipo">
                            <strong>HP EliteBook 840</strong><br>
                            <span class="texto_tenue">Laptop - 16GB RAM</span>
                        </td>
                        <td data-label="Red">
                            PC-VENTAS-01<br>
                            <span class="texto_tenue">192.168.1.45</span>
                        </td>
                        <td data-label="Ubicación">Sucursal Centro<br><span class="texto_tenue">Piso 2</span></td>
                        <td data-label="Estado"><span class="etiqueta etiqueta_operativo">Operativo</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function volver_al_inicio(e) {
            if (e) e.preventDefault();

            var contenedor = document.querySelector('.contenedor_principal');
            contenedor.classList.add('animacion_salida');

            setTimeout(function () {
                location.href = '/Inventario/Index';
            }, 400);
        }
    </script>
</body>
</html>